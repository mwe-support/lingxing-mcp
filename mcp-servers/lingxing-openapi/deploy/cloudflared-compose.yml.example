name: cloudflared-lingxing-mcp

services:
  cloudflared:
    image: docker.m.daocloud.io/cloudflare/cloudflared:2026.7.3
    container_name: cloudflared-lingxing-mcp
    restart: unless-stopped
    network_mode: host
    user: "0:0"
    mem_limit: 128m
    memswap_limit: 128m
    pids_limit: 64
    volumes:
      - /etc/cloudflared/lingxing-mcp.token:/run/secrets/cloudflared_tunnel_token:ro
    command:
      - tunnel
      - --no-autoupdate
      - --protocol
      - http2
      - run
      - --token-file
      - /run/secrets/cloudflared_tunnel_token
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
